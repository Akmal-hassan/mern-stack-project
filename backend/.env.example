NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bluebells
# Optional directory for the development in-memory MongoDB. Choose a drive with at least 1 GB free.
MONGODB_MEMORY_DIR=
SESSION_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://localhost:5173
